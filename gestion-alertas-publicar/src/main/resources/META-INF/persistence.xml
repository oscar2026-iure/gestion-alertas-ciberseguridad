<?xml version="1.0" encoding="UTF-8"?>

<persistence
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
    version="3.2">

    <persistence-unit
        name="AlertasPU"
        transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>ec.monitoreo.alertas.Alerta</class>

        <properties>

            <!-- Conexión con PostgreSQL -->
            <property
                name="jakarta.persistence.jdbc.driver"
                value="org.postgresql.Driver"/>

            <property
                name="jakarta.persistence.jdbc.url"
                value="jdbc:postgresql://localhost:5432/bd_grupociberdefensa"/>

            <property
                name="jakarta.persistence.jdbc.user"
                value="postgres"/>

            <property
                name="jakarta.persistence.jdbc.password"
                value="CAMBIAR_POR_CLAVE_LOCAL"/>

            <!-- Esquema donde se creará la tabla -->
            <property
                name="hibernate.default_schema"
                value="public"/>

            <!-- Creación y actualización de tablas para la práctica -->
            <property
                name="hibernate.hbm2ddl.auto"
                value="update"/>

            <!-- Mostrar las instrucciones SQL en Output -->
            <property
                name="hibernate.show_sql"
                value="true"/>

            <property
                name="hibernate.format_sql"
                value="true"/>

        </properties>

    </persistence-unit>

</persistence>